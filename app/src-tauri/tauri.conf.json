{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rz GameBooster",
  "version": "0.1.7",
  "identifier": "io.renzobraga.rzgamebooster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rz GameBooster",
        "width": 900,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "Spanish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/renzobraga/Rz-GameBooster/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRTdGQzRFNjFGMTI1NEIKUldSTEpmRmhUdnpuUUJ6REZZUExHeHNrMEMrQkdHaVA1ZFgzeVdZM0txYXN2SE5BcFdVSU5kT1oK"
    }
  }
}
